digraph backend {
  rankdir=LR;
  fontname="Helvetica,sans-Serif";
  node [shape=box, style="rounded,filled", fillcolor="#bbfeff", color=black, fontname="Helvetica,sans-Serif", fontsize=9];
  edge [color="#00000033", fontname="Helvetica,sans-Serif", fontsize=9];
  subgraph cluster_1 {
    label="Routing"; fontname="Helvetica,sans-Serif"; fontsize=9; fontweight=bold; style=rounded; color=black;
    "Routing.GpxSerializer";
    "Routing.IOpenRouteServiceClient";
    "Routing.LoopRouteGenerator";
