  "Routing.IOpenRouteServiceClient" -> "Routing.RouteResult";
  "Routing.IOpenRouteServiceClient" -> "Routing.OrsDirectionOptions";
  "Routing.IOpenRouteServiceClient" -> "Routing.OrsRoundTripOptions";
  "Routing.LoopRouteGenerator" -> "Routing.OrsDirectionOptions";
  "Routing.LoopRouteGenerator" -> "Routing.IOpenRouteServiceClient";
  "Routing.LoopRouteGenerator" -> "Routing.RouteCoordinate";
  "Routing.LoopRouteGenerator" -> "Routing.RoutingResult`1";
  "Routing.LoopRouteGenerator" -> "Routing.RouteResult";
  "Routing.LoopRouteGenerator" -> "Routing.OrsRoundTripOptions";
  "Routing.LoopRouteGenerator" -> "Routing.WaypointCalculator";
  "Routing.LoopRouteGenerator" -> "Routing.LoopRouteGenerator+CandidateMetrics";
  "Routing.LoopRouteGenerator" -> "Routing.SmoothnessCalculator";
  "Routing.LoopRouteGenerator" -> "Routing.SpikeDetector";
