  "Routing.OpenRouteServiceClient" -> "Routing.RouteResult";
  "Routing.OpenRouteServiceClient" -> "Routing.OrsDirectionOptions";
  "Routing.OpenRouteServiceClient" -> "Routing.OrsRoundTripOptions";
  "Routing.OrsMapper" -> "Routing.SurfaceType";
  "Routing.OrsMapper" -> "Routing.RoadClass";
  "Routing.OrsMapper" -> "Routing.RouteWaySegment";
  "Routing.OverlapDetector" -> "Routing.RouteCoordinate";
  "Routing.PavedRatioCalculator" -> "Routing.SurfaceType";
  "Routing.PavedRatioCalculator" -> "Routing.RouteResult";
  "Routing.PavedRatioCalculator" -> "Routing.RouteGeometry";
  "Routing.PavedRatioCalculator" -> "Routing.RouteWaySegment";
  "Routing.PavedRatioCalculator" -> "Routing.RouteCoordinate";
  "Routing.RouteResult" -> "Routing.RouteGeometry";
